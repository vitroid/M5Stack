#pragma once

// Copy to include/secrets.h (gitignored) and fill in real values.
//   mkdir -p include && cp secrets.h.example include/secrets.h
// Or generate LAN macros from a one-shot export:
//   cd meross && python export_lan_devices.py && python gen_nodemcu_secrets.py
// Never commit include/secrets.h.

#define WIFI_SSID     "your-ssid"
#define WIFI_PASSWORD "your-wifi-password"

// ---- Preferred: LAN direct (no Mac). From meross/devices.local.json ----
// Account key signs every /config message: md5(messageId + key + timestamp).
#define MEROSS_KEY    "0123456789abcdef0123456789abcdef"
#define MEROSS_CHANNEL 0

#define LAMP_IP       "192.168.1.10"
#define LAMP_UUID     "xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
#define FAN_IP        "192.168.1.11"
#define FAN_UUID      "yyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyy"

// ---- Optional: Mac bridge fallback / key-refresh stub (not required day-to-day) ----
// #define BRIDGE_HOST   "192.168.1.2"
// #define BRIDGE_PORT   8787

// Night-friendly: leave as-is for dark-by-default.
// #define FEEDBACK_LED_PIN  D5
