# Copy to .env (gitignored) or export these in your shell.
# Never commit real credentials.

MEROSS_EMAIL=you@example.com
MEROSS_PASSWORD=your-meross-cloud-password

# Regional cloud API (pick one that matches your Meross account region):
# Asia-Pacific (Japan 含む): https://iotx-ap.meross.com
# Europe:                    https://iotx-eu.meross.com
# US:                        https://iotx-us.meross.com
# Legacy default:            https://iot.meross.com
MEROSS_API_BASE_URL=https://iotx-ap.meross.com

# Optional default target for on/off/toggle/status (device name or UUID)
# MEROSS_DEVICE=Living Room Plug
